{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Start TS Playground",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--disable-extension=dartsx.@dartsx/vscode-extension",
				"--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension/",
				"${workspaceFolder}/playground"
			],
			"outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
			"sourceMaps": true,
			"preLaunchTask": "build-extension"
		},
		{
			"name": "Start Router",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--disable-extension=dartsx.@dartsx/vscode-extension",
				"--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension/",
				"${workspaceFolder}/toolkit/router"
			],
			"outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
			"sourceMaps": true,
			"preLaunchTask": "build-extension"
		},
		{
			"name": "Start Query",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--disable-extension=dartsx.@dartsx/vscode-extension",
				"--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension/",
				"${workspaceFolder}/toolkit/query"
			],
			"outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
			"sourceMaps": true,
			"preLaunchTask": "build-extension"
		},
		{
			"name": "Start Website",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--disable-extension=dartsx.@dartsx/vscode-extension",
				"--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension/",
				"${workspaceFolder}/website"
			],
			"outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
			"sourceMaps": true,
			"preLaunchTask": "build-extension"
		}
	]
}
