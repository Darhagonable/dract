{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-extension",
			"type": "shell",
			"command": "pnpm",
			"args": ["-r", "--filter", "dartsx-typescript-plugin", "--filter", "dartsx-vscode", "run", "build"],
			"group": "build",
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "build-all",
			"type": "shell",
			"command": "pnpm",
			"args": ["-r", "run", "build"],
			"group": "build",
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "test",
			"type": "shell",
			"command": "pnpm",
			"args": ["test"],
			"group": "test",
			"problemMatcher": []
		}
	]
}
