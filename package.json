{
	"name": "dartsx-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "pnpm run build && vitest run && pnpm --filter dartsx-vscode run test",
		"build": "pnpm -r run build",
		"check": "pnpm -r --no-bail run check"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"dartsx-vite-plugin": "workspace:*",
		"jsdom": "^29.1.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"packageManager": "pnpm@10.7.0",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"allowedDeprecatedVersions": {}
	}
}
