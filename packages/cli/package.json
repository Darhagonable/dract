{
	"name": "dartsx-cli",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "DarTsx CLI - type-checking and packaging",
	"bin": {
		"dartsx": "./bin/dartsx.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist"
	],
	"scripts": {
		"build": "tsc --build",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@volar/language-core": "~2.4.28",
		"@volar/typescript": "~2.4.28",
		"chokidar": "^5.0.0",
		"dartsx": "workspace:*",
		"dartsx-typescript-plugin": "workspace:*",
		"kleur": "^4.1.5"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.0",
		"typescript": "^6.0.3"
	}
}
