{
	"name": "dartsx",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"types": "./dist/runtime/external/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/runtime/external/index.d.ts",
			"default": "./dist/runtime/external/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		},
		"./internal/client": {
			"types": "./dist/runtime/internal/client/index.d.ts",
			"default": "./dist/runtime/internal/client/index.js"
		},
		"./compiler": {
			"types": "./dist/compiler/index.d.ts",
			"default": "./dist/compiler/index.js"
		},
		"./compiler/preprocess": {
			"types": "./dist/compiler/preprocess.d.ts",
			"default": "./dist/compiler/preprocess.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@jridgewell/remapping": "^2.3.5",
		"clsx": "^2.1.1",
		"entities": "^8.0.0",
		"esrap": "^2.2.11",
		"magic-string": "^0.30.21",
		"oxc-parser": "^0.136.0",
		"oxc-transform": "^0.136.0",
		"postcss": "^8.5.15",
		"postcss-selector-parser": "^7.1.4",
		"zimmerframe": "^1.1.4"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
