{
	"name": "dartsx",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"types": "./dist/runtime/external/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/runtime/external/index.d.ts",
			"default": "./dist/runtime/external/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		},
		"./internal/client": {
			"types": "./dist/runtime/internal/client/index.d.ts",
			"default": "./dist/runtime/internal/client/index.js"
		},
		"./compiler": {
			"types": "./dist/compiler/index.d.ts",
			"default": "./dist/compiler/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"entities": "^8.0.0",
		"oxc-parser": "^0.66.0",
		"oxc-transform": "^0.127.0",
		"postcss": "^8.5.9",
		"postcss-selector-parser": "^7.1.1"
	},
	"devDependencies": {
		"typescript": "^5.8.2",
		"vitest": "^3.1.1"
	}
}
