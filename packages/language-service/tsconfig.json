{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "CommonJS",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": false,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": ["node"],
		"paths": {
			"*": ["./src/*"]
		}
	},
	"include": ["src", "tests/*.test.ts"]
}
