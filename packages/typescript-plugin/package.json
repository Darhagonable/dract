{
	"name": "dartsx-typescript-plugin",
	"version": "0.0.1",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./language": {
			"types": "./dist/language.d.ts",
			"default": "./dist/language.js"
		},
		"./unused-css": {
			"types": "./dist/unused-css.d.ts",
			"default": "./dist/unused-css.js"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^25.9.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@volar/language-core": "~2.4.28",
		"@volar/typescript": "~2.4.28"
	},
	"peerDependencies": {
		"dartsx": "workspace:*"
	}
}
