{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"outDir": "dist",
		"rootDir": ".",
		"paths": {
			"*": ["./src/*"]
		},
		"types": ["node"],
		"composite": true
	},
	"include": ["src", "tests/*.test.ts"],
	"references": [
		{ "path": "../dartsx" }
	]
}
