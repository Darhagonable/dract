{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"outDir": "dist",
		"rootDir": "src",
		"composite": true
	},
	"include": ["src"],
	"references": [
		{ "path": "../dartsx" }
	]
}
