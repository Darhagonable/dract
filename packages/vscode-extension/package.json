{
	"name": "@dartsx/vscode-extension",
	"displayName": "DarTsx",
	"description": "DarTsx language support — syntax highlighting, diagnostics, completions, and more.",
	"version": "0.0.1",
	"publisher": "dartsx",
	"type": "module",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact"
	],
	"main": "./dist/main.cjs",
	"browser": "./dist/browser.cjs",
	"contributes": {
		"typescriptServerPlugins": [
			{
				"name": "@dartsx/language-service/dist/plugin",
				"enableForWorkspaceTypeScriptVersions": true
			}
		],
		"grammars": [
			{
				"scopeName": "source.dartsx.style.injection",
				"path": "./syntaxes/dartsx.style.injection.tmLanguage.json",
				"injectTo": [
					"source.js",
					"source.js.jsx",
					"source.jsx",
					"source.ts",
					"source.tsx"
				],
				"embeddedLanguages": {
					"source.css": "css"
				}
			},
			{
				"scopeName": "source.dartsx.css-expressions.injection",
				"path": "./syntaxes/dartsx.css-expressions.injection.tmLanguage.json",
				"injectTo": [
					"source.js",
					"source.js.jsx",
					"source.jsx",
					"source.ts",
					"source.tsx"
				]
			},
			{
				"scopeName": "source.dartsx.render.injection",
				"path": "./syntaxes/dartsx.render.injection.tmLanguage.json",
				"injectTo": [
					"source.js",
					"source.js.jsx",
					"source.jsx",
					"source.ts",
					"source.tsx"
				]
			}
		]
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"package": "node scripts/package.ts"
	},
	"dependencies": {
		"@dartsx/language-service": "workspace:*",
		"@volar/language-server": "~2.4.28",
		"volar-service-css": "0.0.71",
		"volar-service-html": "0.0.71",
		"vscode-languageclient": "^10.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.120.0",
		"@vscode-tmlanguage-snapshot/vscode": "^2.0.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"vitest-environment-vscode": "^0.1.3"
	}
}
