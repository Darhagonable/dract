{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"paths": {
			"*": ["./src/*"]
		}
	},
	"include": ["src", "scripts", "tests"],
	"exclude": ["tests/fixture"]
}
