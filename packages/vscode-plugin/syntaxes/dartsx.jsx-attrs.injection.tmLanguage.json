{
	"scopeName": "source.dartsx.jsx-attrs.injection",
	"injectionSelector": "L:meta.tag.attributes.js.jsx -comment -string, L:meta.tag.attributes.tsx -comment -string",
	"patterns": [
		{ "include": "#dartsx-bind-attr" }
	],
	"repository": {
		"dartsx-bind-attr": {
			"match": "(bind):([a-zA-Z][\\w-]*)",
			"captures": {
				"1": { "name": "storage.modifier.bind.dartsx" },
				"2": { "name": "entity.other.attribute-name.binding.dartsx" }
			}
		}
	}
}
