{
	"scopeName": "source.dartsx.render.injection",
	"injectionSelector": "L:source.js - comment, L:source.js.jsx - comment, L:source.jsx - comment, L:source.ts - comment, L:source.tsx - comment, L:meta.embedded.expression.tsx - comment, L:meta.embedded.expression.js - comment, L:meta.objectliteral.tsx - comment, L:meta.objectliteral.js - comment",
	"patterns": [
		{ "include": "#component" },
		{ "include": "#state" },
		{ "include": "#derived" },
		{ "include": "#render-inline" },
		{ "include": "#render-block" },
		{ "include": "#jsx-control-keywords" },
		{ "include": "#jsx-tag" }
	],
	"repository": {
		"component": {
			"begin": "(?:\\b(export)\\s+(?:(default)\\s+)?(?:(async)\\s+)?)?\\b(component)\\s+([A-Za-z_$][\\w$]*)\\s*(\\()",
			"beginCaptures": {
				"1": { "name": "keyword.control.export.tsx" },
				"2": { "name": "keyword.control.default.tsx" },
				"3": { "name": "storage.modifier.async.tsx" },
				"4": { "name": "storage.type.component.dartsx" },
				"5": { "name": "entity.name.function.component.dartsx" },
				"6": { "name": "punctuation.definition.parameters.begin.tsx" }
			},
			"end": "(\\))\\s*(?=\\{)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.parameters.end.tsx" }
			},
			"contentName": "meta.parameters.tsx",
			"patterns": [
				{
					"match": "\\b(bind)(?=\\s+(?:['\"]|[A-Za-z_$]))",
					"name": "storage.modifier.bind.dartsx"
				},
				{
					"match": "\\b(as)\\b",
					"name": "keyword.control.as.dartsx"
				},
				{
					"include": "source.tsx#function-parameters-body"
				}
			]
		},
		"state": {
			"begin": "(?:(export)\\s+)?\\b(state)\\s+([A-Za-z_$][\\w$]*)",
			"beginCaptures": {
				"1": { "name": "keyword.control.export.tsx" },
				"2": { "name": "storage.type.state.dartsx" },
				"3": { "name": "variable.other.readwrite.tsx" }
			},
			"end": "(?=;|$)",
			"patterns": [
				{ "include": "source.tsx#type-annotation" },
				{ "include": "source.tsx#expression" }
			]
		},
		"derived": {
			"begin": "(?:(export)\\s+)?\\b(derived)\\s+([A-Za-z_$][\\w$]*)",
			"beginCaptures": {
				"1": { "name": "keyword.control.export.tsx" },
				"2": { "name": "storage.type.derived.dartsx" },
				"3": { "name": "variable.other.constant.tsx" }
			},
			"end": "(?=;|$)",
			"patterns": [
				{ "include": "source.tsx#type-annotation" },
				{ "include": "source.tsx#expression" }
			]
		},
		"render-inline": {
			"begin": "\\b(render)\\s*(?=<)",
			"beginCaptures": { "1": { "name": "keyword.control.render.dartsx" } },
			"end": ";|$",
			"patterns": [{ "include": "#jsx" }]
		},
		"render-block": {
			"begin": "\\b(render)\\s*(\\()",
			"beginCaptures": {
				"1": { "name": "keyword.control.render.dartsx" },
				"2": { "name": "meta.brace.round.tsx" }
			},
			"end": "^(\\s*)(\\));?\\s*$",
			"endCaptures": { "2": { "name": "meta.brace.round.tsx" } },
			"patterns": [{ "include": "#jsx" }]
		},

		"jsx": {
			"patterns": [
				{ "include": "#jsx-tag" },
				{ "include": "#jsx-expression" }
			]
		},
		"jsx-tag": {
			"begin": "(<)(/?)([a-zA-Z][\\w.$-]*)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.js.jsx" },
				"2": { "name": "punctuation.definition.tag.begin.js.jsx" },
				"3": { "patterns": [{ "include": "#jsx-tag-name" }] }
			},
			"end": "(/?>)",
			"endCaptures": { "1": { "name": "punctuation.definition.tag.end.js.jsx" } },
			"name": "meta.tag.js.jsx",
			"patterns": [{ "include": "#jsx-attributes" }]
		},
		"jsx-tag-name": {
			"patterns": [
				{ "match": "[A-Z][\\w.$]*", "name": "support.class.component.js.jsx" },
				{ "match": "[a-z][\\w-]*", "name": "entity.name.tag.js.jsx" }
			]
		},
		"jsx-expression": {
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.js.jsx" } },
			"end": "\\}",
			"endCaptures": { "0": { "name": "punctuation.section.embedded.end.js.jsx" } },
			"contentName": "meta.embedded.expression.js.jsx",
			"patterns": [
				{ "include": "#jsx" },
				{ "include": "#jsx-control-keywords" },
				{ "include": "source.tsx#statements" }
			]
		},
		"jsx-control-keywords": {
			"patterns": [
				{ "match": "\\b(if|else)\\b", "name": "keyword.control.conditional.tsx" },
				{ "match": "\\b(for|while|do)\\b", "name": "keyword.control.loop.tsx" },
				{ "match": "\\b(const|let|var)\\b", "name": "storage.type.tsx" },
				{ "match": "\\b(of|in)\\b", "name": "keyword.operator.expression.of.tsx" },
				{ "match": "\\b(break|continue|return)\\b", "name": "keyword.control.flow.tsx" },
				{ "match": "\\b(switch|case|default)\\b", "name": "keyword.control.switch.tsx" },
				{ "match": "\\b(try|catch|finally|throw)\\b", "name": "keyword.control.trycatch.tsx" },
				{ "match": "\\b(pending)\\b", "name": "keyword.control.dartsx" },
				{ "match": "\\b(index|key)\\b", "name": "keyword.other.dartsx" }
			]
		},
		"jsx-attributes": {
			"patterns": [
				{
					"begin": "([a-zA-Z_:][\\w.:$-]*)\\s*(=)\\s*(\\{)",
					"beginCaptures": {
						"1": { "name": "entity.other.attribute-name.js.jsx" },
						"2": { "name": "keyword.operator.assignment.js.jsx" },
						"3": { "name": "punctuation.section.embedded.begin.js.jsx" }
					},
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.section.embedded.end.js.jsx" } },
					"contentName": "meta.embedded.expression.js.jsx",
					"patterns": [
						{ "include": "#jsx-expression" },
						{ "include": "source.tsx#expression" }
					]
				},
				{
					"match": "([a-zA-Z_:][\\w.:$-]*)\\s*(=)\\s*([\"'][^\"']*[\"'])",
					"captures": {
						"1": { "name": "entity.other.attribute-name.js.jsx" },
						"2": { "name": "keyword.operator.assignment.js.jsx" },
						"3": { "name": "string.quoted.js.jsx" }
					}
				},
				{
					"match": "([a-zA-Z_:][\\w.:$-]*)(?=\\s|/?>)",
					"name": "entity.other.attribute-name.js.jsx"
				}
			]
		}
	}
}
