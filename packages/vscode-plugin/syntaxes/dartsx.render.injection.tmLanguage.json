{
	"scopeName": "source.dartsx.render.injection",
	"injectionSelector": "L:source.js, L:source.js.jsx, L:source.jsx, L:source.ts, L:source.tsx",
	"patterns": [
		{ "include": "#component" },
		{ "include": "#state" },
		{ "include": "#derived" },
		{ "include": "#render-inline" },
		{ "include": "#render-block" }
	],
	"repository": {
		"component": {
			"begin": "\\b(component)\\s+([A-Za-z_$][\\w$]*)\\s*(\\()",
			"beginCaptures": {
				"1": { "name": "storage.type.component.dartsx" },
				"2": { "name": "entity.name.function.component.dartsx" },
				"3": { "name": "punctuation.definition.parameters.begin.tsx" }
			},
			"end": "(\\))\\s*(?=\\{)",
			"endCaptures": {
				"1": { "name": "punctuation.definition.parameters.end.tsx" }
			},
			"patterns": [
				{
					"match": "\\b(bind)(?=\\s+(?:['\"]|[A-Za-z_$]))",
					"name": "storage.modifier.bind.dartsx"
				},
				{
					"match": "\\b(as)\\b",
					"name": "keyword.control.as.dartsx"
				},
				{
					"match": "\\b(string|number|boolean|any|void|never|undefined|null|unknown|object|bigint|symbol)\\b",
					"name": "support.type.primitive.ts"
				},
				{
					"match": "\\b([A-Z][\\w$]*)\\b",
					"name": "entity.name.type.ts"
				},
				{
					"match": "\\.\\.\\.",
					"name": "keyword.operator.spread.ts"
				},
				{
					"include": "source.tsx#string"
				},
				{
					"include": "source.tsx#numeric-literal"
				}
			]
		},
		"state": {
			"match": "\\b(state)\\s+([A-Za-z_$][\\w$]*)",
			"captures": {
				"1": { "name": "storage.type.state.dartsx" },
				"2": { "name": "variable.other.readwrite.tsx" }
			}
		},
		"derived": {
			"match": "\\b(derived)\\s+(?=[A-Za-z_$\\{\\[])",
			"captures": {
				"1": { "name": "storage.type.derived.dartsx" }
			}
		},
		"render-inline": {
			"begin": "\\b(render)\\s*(?=<)",
			"beginCaptures": { "1": { "name": "keyword.control.render.dartsx" } },
			"end": ";|$",
			"patterns": [{ "include": "#jsx" }]
		},
		"render-block": {
			"begin": "\\b(render)\\s*(\\()",
			"beginCaptures": {
				"1": { "name": "keyword.control.render.dartsx" },
				"2": { "name": "meta.brace.round.tsx" }
			},
			"end": "^(\\s*)(\\))",
			"endCaptures": { "2": { "name": "meta.brace.round.tsx" } },
			"patterns": [{ "include": "#jsx" }]
		},

		"jsx": {
			"patterns": [
				{ "include": "#jsx-tag" },
				{ "include": "#jsx-expression" }
			]
		},
		"jsx-tag": {
			"begin": "(<)(/?)([a-zA-Z][\\w.$-]*)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.js.jsx" },
				"2": { "name": "punctuation.definition.tag.begin.js.jsx" },
				"3": { "patterns": [{ "include": "#jsx-tag-name" }] }
			},
			"end": "(/?>)",
			"endCaptures": { "1": { "name": "punctuation.definition.tag.end.js.jsx" } },
			"name": "meta.tag.js.jsx",
			"patterns": [{ "include": "#jsx-attributes" }]
		},
		"jsx-tag-name": {
			"patterns": [
				{ "match": "[A-Z][\\w.$]*", "name": "support.class.component.js.jsx" },
				{ "match": "[a-z][\\w-]*", "name": "entity.name.tag.js.jsx" }
			]
		},
		"jsx-expression": {
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.js.jsx" } },
			"end": "\\}",
			"endCaptures": { "0": { "name": "punctuation.section.embedded.end.js.jsx" } },
			"contentName": "meta.embedded.expression.js.jsx",
			"patterns": [
				{ "include": "#jsx" },
				{ "include": "#jsx-control-keywords" },
				{ "include": "source.tsx#var-expr" },
				{ "include": "source.tsx#expression" },
				{ "include": "source.tsx#punctuation-semicolon" }
			]
		},
		"jsx-control-keywords": {
			"patterns": [
				{ "match": "\\b(if|else)\\b", "name": "keyword.control.conditional.tsx" },
				{ "match": "\\b(for|while|do)\\b", "name": "keyword.control.loop.tsx" },
				{ "match": "\\b(break|continue)\\b", "name": "keyword.control.loop.tsx" },
				{ "match": "\\b(switch|case|default)\\b", "name": "keyword.control.switch.tsx" },
				{ "match": "\\b(try|catch|finally|throw)\\b", "name": "keyword.control.trycatch.tsx" },
				{ "match": "\\b(return)\\b", "name": "keyword.control.flow.tsx" },
				{ "match": "\\b(index)\\b", "name": "keyword.other.dartsx" }
			]
		},
		"jsx-attributes": {
			"patterns": [
				{
					"begin": "([a-zA-Z_:][\\w.:$-]*)\\s*(=)\\s*(\\{)",
					"beginCaptures": {
						"1": { "name": "entity.other.attribute-name.js.jsx" },
						"2": { "name": "keyword.operator.assignment.js.jsx" },
						"3": { "name": "punctuation.section.embedded.begin.js.jsx" }
					},
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.section.embedded.end.js.jsx" } },
					"contentName": "meta.embedded.expression.js.jsx",
					"patterns": [
						{ "include": "#jsx-expression" },
						{ "include": "source.tsx#expression" }
					]
				},
				{
					"match": "([a-zA-Z_:][\\w.:$-]*)\\s*(=)\\s*([\"'][^\"']*[\"'])",
					"captures": {
						"1": { "name": "entity.other.attribute-name.js.jsx" },
						"2": { "name": "keyword.operator.assignment.js.jsx" },
						"3": { "name": "string.quoted.js.jsx" }
					}
				},
				{
					"match": "([a-zA-Z_:][\\w.:$-]*)(?=\\s|/?>)",
					"name": "entity.other.attribute-name.js.jsx"
				}
			]
		}
	}
}
